# Settings cities to collect (default: all 12 PWA cities)
# Also used by GitHub Actions collect.yml (repo Variable CITIES)
# CITIES=all
# CITIES=kosice,bratislava,presov

# Days of price freshness window on benzin.sk (2/7/14/30/60/90)
DAY_WINDOW=14

# Pause between HTTP requests (ms) — keep ≥1500–2000 in CI
REQUEST_DELAY_MS=1500

# Identify the crawler; include a contact if you publish the repo
USER_AGENT=FuelSK/0.1 (+https://github.com/krmll/fuelsk; local collector)

# Used for Nominatim fallback (Photon is primary)
# In Actions: set secret/variable NOMINATIM_EMAIL
NOMINATIM_EMAIL=you@example.com
